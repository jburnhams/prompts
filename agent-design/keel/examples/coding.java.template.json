{
  "name": "coding.java",
  "version": 1,
  "title": "Java developer",
  "description": "Use case 1: a saved tool group, a saved prompt, a repository and a task. It ends by choosing one of three finishers instead of a generic Complete, and can ask for help mid-run.",
  "owner": {
    "type": "team",
    "id": "java-platform"
  },
  "params": {
    "repository": {
      "type": "string",
      "trust": "config",
      "required": true,
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "base_branch": {
      "type": "string",
      "trust": "config",
      "default": "main",
      "pattern": "^[A-Za-z0-9_./-]{1,200}$"
    },
    "target_branch": {
      "type": "string",
      "trust": "config",
      "required": true,
      "pattern": "^[A-Za-z0-9_./-]{1,200}$"
    },
    "issue_key": {
      "type": "string",
      "trust": "config",
      "required": true,
      "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$"
    },
    "task": {
      "type": "string",
      "trust": "principal",
      "required": true,
      "max_length": 20000,
      "description": "The task details: the starting query."
    },
    "tier": {
      "type": "tier",
      "trust": "config",
      "default": "standard",
      "max_tier": "strong"
    }
  },
  "spec": {
    "model": {
      "tier": {
        "$param": "tier"
      },
      "effort": "high",
      "max_tier": "strong"
    },
    "system_prompt": {
      "base": {
        "ref": {
          "name": "java.developer",
          "version": 1
        }
      },
      "generated": [
        "env",
        "capabilities",
        "git_status",
        "repo_context"
      ]
    },
    "inputs": [
      {
        "name": "task",
        "kind": "instruction",
        "source": {
          "param": "task"
        },
        "trust": "principal"
      },
      {
        "name": "resumed_answer",
        "kind": "resumed_answer",
        "source": {
          "carry": "resumed_answer"
        },
        "trust": "principal",
        "required": false
      },
      {
        "name": "plan",
        "kind": "plan",
        "source": {
          "carry": "plan"
        },
        "trust": "harness",
        "required": false
      }
    ],
    "context": {
      "conventions": {
        "tiers": [
          "org",
          "team",
          "repo"
        ],
        "at": "working_tree",
        "tags": [
          "conventions",
          "testing"
        ]
      }
    },
    "workspace": {
      "kind": "checkout",
      "repository": {
        "$param": "repository"
      },
      "base_ref": {
        "$param": "base_branch"
      },
      "target_branch": {
        "$param": "target_branch"
      },
      "writable": true
    },
    "tools": {
      "servers": [
        {
          "id": "jira"
        },
        {
          "id": "scm"
        }
      ],
      "groups": [
        {
          "ref": {
            "name": "java.coding",
            "version": 3
          },
          "id": "java"
        },
        {
          "id": "endings",
          "description": "The ways this agent may end its run. Granted with use: finish only, so none of them can be called mid-run.",
          "tools": [
            {
              "tool": "mcp:scm/open_pull_request",
              "annotations": {
                "idempotent": false,
                "retry": "never"
              },
              "use": [
                "finish"
              ],
              "finish": {
                "name": "OpenPullRequest",
                "description": "Ends your run: commits your changes, pushes the branch and opens a pull request. Use when the task is done and verified.",
                "status": "done",
                "report": true
              },
              "params": {
                "draft": {
                  "fixed": false,
                  "hidden": true
                },
                "labels": {
                  "fixed": [
                    "agent"
                  ],
                  "hidden": true
                },
                "base": {
                  "fixed": {
                    "$param": "base_branch"
                  },
                  "hidden": true
                }
              },
              "links": {
                "pull_request": {
                  "cel": "result.url"
                }
              }
            },
            {
              "tool": "mcp:jira/update_issue",
              "annotations": {
                "idempotent": false,
                "retry": "never"
              },
              "use": [
                "finish"
              ],
              "finish": {
                "name": "FinishWithJiraUpdate",
                "description": "Ends your run with a Jira update and no pull request: for a task whose answer is a finding, not a code change.",
                "status": "done",
                "report": true
              },
              "params": {
                "key": {
                  "fixed": {
                    "$param": "issue_key"
                  },
                  "hidden": true
                },
                "transition": {
                  "enum": [
                    "In Review",
                    "Blocked"
                  ]
                }
              }
            },
            {
              "tool": "builtin/RequestHelp",
              "use": [
                "finish"
              ],
              "finish": {
                "name": "RequestHelp",
                "description": "Ends your run and hands the task to the team. Use only when you cannot finish and no single question would unblock you; for a question, use AskUser, which lets you continue.",
                "status": "blocked",
                "report": true
              },
              "params": {
                "channel": {
                  "fixed": "#java-platform-agents",
                  "hidden": true
                }
              }
            }
          ]
        }
      ],
      "checks": [
        {
          "id": "input_sanitizer"
        },
        {
          "id": "git_write_blocklist"
        },
        {
          "id": "read_before_edit"
        },
        {
          "id": "completion_checklist"
        },
        {
          "id": "post_run_crosscheck"
        }
      ]
    },
    "human": {
      "ask_user": {
        "kinds": [
          "clarify"
        ],
        "principal_set": [
          "requested_by",
          "issue_assignee"
        ],
        "channels": [
          {
            "type": "jira_comment",
            "target": {
              "$param": "issue_key"
            }
          }
        ]
      }
    },
    "completion": {
      "complete": false,
      "statuses": [
        "done",
        "blocked",
        "failed",
        "budget_exhausted"
      ],
      "report_schema": {
        "ref": {
          "name": "forge.report.implement",
          "version": 1
        }
      },
      "checks": [
        {
          "id": "first_done_checklist",
          "on_status": [
            "done"
          ]
        },
        {
          "id": "report_crosscheck"
        }
      ]
    },
    "budgets": {
      "turns": 150,
      "context_high_water_tokens": 160000,
      "wall_seconds": 5400
    },
    "outputs": {
      "sinks": [
        {
          "id": "ticket_note",
          "kind": "comment",
          "when": {
            "terminal": [
              "complete"
            ]
          },
          "channel": {
            "type": "jira_comment",
            "target": {
              "$param": "issue_key"
            }
          },
          "render": {
            "template": "**{{status}}** via {{finisher.id}}\n\n{{summary}}"
          }
        }
      ]
    },
    "authority": {
      "run_as": [
        "user"
      ],
      "service_principal": {
        "type": "service",
        "id": "java-agent"
      },
      "delegation": {
        "max_ttl_days": 30
      }
    },
    "concurrency": {
      "key": {
        "cel": "params.repository + '#' + params.target_branch"
      }
    },
    "agents": {
      "orchestrator": {
        "grant": [
          "java",
          "endings"
        ]
      }
    },
    "stage_defaults": {
      "retry": {
        "max_attempts": 2,
        "raise_budgets": {
          "turns": 1.5
        }
      },
      "settle": {
        "event": "pr",
        "ref": {
          "cel": "stage.links.pull_request"
        },
        "done_when": [
          "merged"
        ],
        "abandon_when": [
          "closed_unmerged"
        ]
      }
    }
  }
}

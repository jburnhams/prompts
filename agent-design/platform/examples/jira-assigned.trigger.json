{
  "name": "jira.assigned-to-forge",
  "owner": { "type": "team", "id": "platform-agents" },
  "enabled": true,
  "pipeline": { "name": "jira.plan-implement", "version": "latest" },
  "source": { "kind": "event", "provider": "jira", "types": ["issue.assigned"], "scope": ["PROJ", "PAY"] },
  "filter": { "cel": "event.payload.assignee.id == 'forge-bot' && has(event.payload.fields.repository)" },
  "params": {
    "issue_key": { "cel": "event.subject" },
    "repository": { "cel": "event.payload.fields.repository" },
    "target_branch": { "cel": "lowerAscii(event.subject) + '-' + event.payload.slug" }
  },
  "origin": { "channel": "jira_comment", "ref": { "cel": "event.subject" } },
  "run_as": { "mode": "event_actor", "actor": { "cel": "event.actor" }, "fallback": "refuse" },
  "dedupe": { "key": { "cel": "event.subject + ':assigned'" }, "window_s": 3600 },
  "concurrency": { "key": { "cel": "event.subject" }, "max_running": 1, "policy": "queue" },
  "rate_limit": { "per_hour": 30 },
  "creates": "task"
}

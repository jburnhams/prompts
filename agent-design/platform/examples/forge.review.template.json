{
  "name": "forge.review",
  "version": 1,
  "title": "Forge: review a pull request",
  "description": "Multi-stage review (review.md \u00a76): specialists by kind, then an independent validator per candidate. Runs as the service identity; posts through AddComment in-run and publishes the attention tier as a commit status.",
  "owner": {
    "type": "team",
    "id": "platform-agents"
  },
  "params": {
    "pull_request": {
      "type": "string",
      "trust": "config",
      "required": true,
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+#[0-9]+$"
    },
    "repository": {
      "type": "string",
      "trust": "config",
      "required": true,
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "base_sha": {
      "type": "string",
      "trust": "config",
      "required": true,
      "pattern": "^[0-9a-f]{40}$"
    },
    "head_sha": {
      "type": "string",
      "trust": "config",
      "required": true,
      "pattern": "^[0-9a-f]{40}$"
    },
    "lenses": {
      "type": "string_list",
      "trust": "config",
      "default": [
        "bugs",
        "security",
        "conventions"
      ],
      "subset_of": [
        "bugs",
        "security",
        "conventions",
        "visual"
      ]
    }
  },
  "spec": {
    "model": {
      "tier": "standard",
      "max_tier": "strong"
    },
    "system_prompt": {
      "base": {
        "ref": {
          "name": "forge.review.multi-stage",
          "version": 9
        }
      },
      "generated": [
        "env",
        "capabilities",
        "repo_context"
      ]
    },
    "inputs": [
      {
        "name": "task",
        "kind": "task_header",
        "source": {
          "builder": "task_header"
        },
        "trust": "harness"
      },
      {
        "name": "pull_request",
        "kind": "pull_request",
        "source": {
          "fetch": "mcp:bitbucket/get_pull_request",
          "args": {
            "ref": {
              "$param": "pull_request"
            }
          }
        },
        "trust": "external"
      },
      {
        "name": "changed_files",
        "kind": "json",
        "source": {
          "builder": "changed_files"
        },
        "trust": "harness"
      },
      {
        "name": "diff",
        "kind": "diff",
        "source": {
          "builder": "review_diff"
        },
        "trust": "external",
        "max_bytes": 400000
      },
      {
        "name": "existing_comments",
        "kind": "comments",
        "source": {
          "builder": "comment_threads"
        },
        "trust": "external",
        "required": false
      }
    ],
    "context": {
      "conventions": {
        "tiers": [
          "org",
          "team",
          "repo",
          "learned"
        ],
        "kinds": {
          "$param": "lenses"
        },
        "at": "base_sha"
      }
    },
    "workspace": {
      "kind": "checkout",
      "repository": {
        "$param": "repository"
      },
      "head_sha": {
        "$param": "head_sha"
      },
      "base_ref": {
        "$param": "base_sha"
      },
      "provision": "sparse_clone",
      "writable": false,
      "scratch": true,
      "git_writes": "deny"
    },
    "tools": {
      "servers": [
        {
          "id": "bitbucket"
        }
      ],
      "groups": [
        {
          "id": "core.read",
          "visibility": "loaded",
          "tools": [
            {
              "tool": "builtin/Read"
            },
            {
              "tool": "builtin/Grep"
            },
            {
              "tool": "builtin/List"
            }
          ]
        },
        {
          "id": "vision",
          "visibility": "loaded",
          "tools": [
            {
              "tool": "builtin/InspectImage"
            }
          ]
        },
        {
          "id": "pr.read",
          "visibility": "loaded",
          "tools": [
            {
              "tool": "mcp:bitbucket/get_pull_request",
              "annotations": {
                "read_only": true,
                "idempotent": true,
                "retry": "on_transport_error"
              }
            }
          ]
        },
        {
          "id": "pr.comment",
          "visibility": "loaded",
          "tools": [
            {
              "tool": "mcp:bitbucket/add_comment",
              "alias": "AddComment",
              "annotations": {
                "idempotent": false,
                "retry": "never"
              }
            }
          ]
        }
      ],
      "checks": [
        {
          "id": "input_sanitizer"
        },
        {
          "id": "anchor_validation"
        },
        {
          "id": "secret_scan"
        },
        {
          "id": "post_run_crosscheck"
        }
      ]
    },
    "roles": {
      "orchestrator": {
        "grant": [
          "core.read",
          "vision",
          "pr.comment"
        ],
        "spawns": [
          "reviewer",
          "validator"
        ],
        "max_concurrent_children": 8
      },
      "reviewer": {
        "description": "Read-only specialist. Pass role to choose the lens.",
        "prompt": {
          "base": {
            "ref": {
              "name": "forge.reviewer-core",
              "version": 7
            }
          },
          "generated": [
            "env",
            "capabilities",
            "repo_context"
          ]
        },
        "model": {
          "tier": "economy",
          "clamp_to_parent": true
        },
        "grant": [
          "core.read"
        ],
        "spawn_kinds": [
          "bugs",
          "security",
          "conventions",
          "visual"
        ],
        "kind_grants": {
          "visual": [
            "vision"
          ]
        },
        "report_schema": {
          "$ref": "https://forge.example/schemas/reports/finding-list.json"
        }
      },
      "validator": {
        "description": "Read-only. Checks exactly one candidate finding against the code, not against the finder's argument.",
        "prompt": {
          "base": {
            "ref": {
              "name": "forge.validator",
              "version": 6
            }
          },
          "generated": [
            "env",
            "capabilities"
          ]
        },
        "model": {
          "tier": "strong",
          "clamp_to_parent": false
        },
        "grant": [
          "core.read"
        ],
        "spawn_args": {
          "finding": {
            "type": "object",
            "description": "The candidate, in the review-finding schema."
          }
        }
      }
    },
    "completion": {
      "statuses": [
        "done",
        "skipped",
        "failed",
        "budget_exhausted"
      ],
      "report_schema": {
        "ref": {
          "name": "forge.report.review",
          "version": 4
        }
      },
      "gates": [
        {
          "id": "report_crosscheck"
        }
      ]
    },
    "budgets": {
      "turns": 60,
      "context_high_water_tokens": 150000,
      "wall_seconds": 2400,
      "subagents_total": 40
    },
    "outputs": {
      "sinks": [
        {
          "id": "attention_status",
          "kind": "commit_status",
          "when": {
            "terminal": [
              "complete"
            ],
            "status": [
              "done"
            ]
          },
          "channel": {
            "type": "bitbucket_pr",
            "target": {
              "$param": "pull_request"
            }
          },
          "render": {
            "template": "attention: {{report.attention.tier}}"
          },
          "idempotency_key": {
            "cel": "params.head_sha + ':attention'"
          }
        }
      ],
      "continuations": []
    },
    "authority": {
      "run_as": [
        "service"
      ],
      "service_principal": {
        "type": "service",
        "id": "forge-bot"
      }
    },
    "concurrency": {
      "key": {
        "cel": "params.pull_request"
      },
      "policy": "queue"
    }
  }
}

{
  "name": "forge.implement",
  "version": 1,
  "title": "Forge: implement a ticket",
  "description": "The coding entrypoint in implement mode (system-prompts.md \u00a71). Edits a harness-provisioned checkout and leaves it for the committer.",
  "owner": {
    "type": "team",
    "id": "platform-agents"
  },
  "params": {
    "issue_key": {
      "type": "string",
      "trust": "config",
      "required": true,
      "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$"
    },
    "repository": {
      "type": "string",
      "trust": "config",
      "required": true,
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "base_branch": {
      "type": "string",
      "trust": "config",
      "default": "main",
      "pattern": "^[A-Za-z0-9_./-]{1,200}$"
    },
    "target_branch": {
      "type": "string",
      "trust": "config",
      "required": true,
      "pattern": "^[A-Za-z0-9_./-]{1,200}$"
    },
    "write_scope": {
      "type": "string_list",
      "trust": "config",
      "default": [
        "**"
      ],
      "pattern": "^(?!.*\\.\\.)(?!/)[A-Za-z0-9_./*{},-]{1,200}$",
      "description": "Path globs this task may write, relative to the checkout. Narrower for spun-off tasks."
    },
    "kinds": {
      "type": "string_list",
      "trust": "config",
      "default": [],
      "subset_of": [
        "bugs",
        "security",
        "conventions",
        "visual",
        "ux",
        "performance",
        "testing",
        "data"
      ]
    },
    "turns": {
      "type": "integer",
      "trust": "config",
      "default": 120,
      "minimum": 10,
      "maximum": 250
    }
  },
  "spec": {
    "model": {
      "tier": "standard",
      "effort": "high",
      "max_tier": "strong"
    },
    "system_prompt": {
      "base": {
        "ref": {
          "name": "forge.coding",
          "version": 14
        }
      },
      "omit_sections": [
        {
          "heading": "Delegating",
          "when": {
            "tool_absent": "Task"
          }
        }
      ],
      "generated": [
        "env",
        "capabilities",
        "git_status",
        "repo_context"
      ]
    },
    "inputs": [
      {
        "name": "task",
        "kind": "task_header",
        "source": {
          "builder": "task_header"
        },
        "trust": "harness"
      },
      {
        "name": "ticket",
        "kind": "issue",
        "source": {
          "fetch": "mcp:jira/get_issue",
          "args": {
            "key": {
              "$param": "issue_key"
            }
          }
        },
        "trust": "external",
        "max_bytes": 65536
      },
      {
        "name": "plan",
        "kind": "plan",
        "source": {
          "carry": "plan"
        },
        "trust": "harness",
        "required": false
      },
      {
        "name": "prior_attempt",
        "kind": "prior_attempt",
        "source": {
          "carry": "prior_attempt"
        },
        "trust": "harness",
        "required": false
      },
      {
        "name": "approved_action",
        "kind": "approved_action",
        "source": {
          "carry": "approved_action"
        },
        "trust": "harness",
        "required": false
      },
      {
        "name": "resumed_answer",
        "kind": "resumed_answer",
        "source": {
          "carry": "resumed_answer"
        },
        "trust": "principal",
        "required": false
      },
      {
        "name": "spinoff_report",
        "kind": "json",
        "source": {
          "carry": "spinoff_report"
        },
        "trust": "harness",
        "required": false
      },
      {
        "name": "findings",
        "kind": "findings",
        "source": {
          "carry": "findings"
        },
        "trust": "harness",
        "required": false
      }
    ],
    "context": {
      "conventions": {
        "tiers": [
          "org",
          "team",
          "repo",
          "learned"
        ],
        "paths": {
          "$param": "write_scope"
        },
        "kinds": {
          "$param": "kinds"
        },
        "at": "working_tree"
      }
    },
    "workspace": {
      "kind": "checkout",
      "repository": {
        "$param": "repository"
      },
      "base_ref": {
        "$param": "base_branch"
      },
      "target_branch": {
        "$param": "target_branch"
      },
      "provision": "worktree",
      "writable": true,
      "write_scope": {
        "$param": "write_scope"
      },
      "scratch": true,
      "git_writes": "deny"
    },
    "tools": {
      "servers": [
        {
          "id": "jira"
        }
      ],
      "groups": [
        {
          "id": "core.read",
          "visibility": "loaded",
          "tools": [
            {
              "tool": "builtin/Read"
            },
            {
              "tool": "builtin/Grep"
            },
            {
              "tool": "builtin/List"
            }
          ]
        },
        {
          "id": "core.write",
          "visibility": "loaded",
          "tools": [
            {
              "tool": "builtin/Edit"
            },
            {
              "tool": "builtin/Write"
            }
          ]
        },
        {
          "id": "core.shell",
          "visibility": "loaded",
          "tools": [
            {
              "tool": "builtin/Bash",
              "limits": {
                "timeout_s": 600,
                "context_chars": 30000
              }
            }
          ]
        },
        {
          "id": "vision",
          "visibility": "loaded",
          "tools": [
            {
              "tool": "builtin/InspectImage"
            }
          ]
        },
        {
          "id": "jira.read",
          "visibility": "loaded",
          "tools": [
            {
              "tool": "mcp:jira/get_issue",
              "alias": "FetchJira",
              "annotations": {
                "read_only": true,
                "idempotent": true,
                "concurrency_safe": true,
                "retry": "on_transport_error"
              }
            }
          ]
        },
        {
          "id": "jira.comment",
          "visibility": "loaded",
          "tools": [
            {
              "tool": "mcp:jira/add_comment",
              "alias": "AddComment",
              "annotations": {
                "destructive": false,
                "idempotent": false,
                "retry": "never"
              }
            }
          ]
        }
      ],
      "checks": [
        {
          "id": "input_sanitizer"
        },
        {
          "id": "git_write_blocklist"
        },
        {
          "id": "read_before_edit"
        },
        {
          "id": "completion_checklist"
        },
        {
          "id": "post_run_crosscheck"
        },
        {
          "id": "conventions_write_flag"
        }
      ]
    },
    "roles": {
      "orchestrator": {
        "grant": [
          "core.read",
          "core.write",
          "core.shell",
          "vision",
          "jira.read"
        ],
        "spawns": [
          "general-purpose"
        ],
        "max_concurrent_children": 4
      },
      "general-purpose": {
        "description": "Open-ended search or investigation you are not confident a direct Read/Grep/List will resolve quickly.",
        "prompt": {
          "base": {
            "ref": {
              "name": "forge.general-purpose",
              "version": 5
            }
          },
          "generated": [
            "env",
            "capabilities"
          ]
        },
        "model": {
          "tier": "standard",
          "clamp_to_parent": true
        },
        "grant": [
          "core.read",
          "core.write",
          "core.shell",
          "vision"
        ]
      }
    },
    "human": {
      "ask_user": {
        "kinds": [
          "clarify",
          "approve"
        ],
        "principal_set": [
          "issue_assignee",
          "issue_reporter",
          "requested_by"
        ],
        "channels": [
          {
            "type": "jira_comment",
            "target": {
              "$param": "issue_key"
            }
          }
        ],
        "max_suspensions": 3,
        "expires_after_s": 1209600,
        "on_expiry": "abandon_task"
      },
      "narrate": {
        "max_entries": 8
      }
    },
    "completion": {
      "statuses": [
        "done",
        "skipped",
        "failed",
        "blocked",
        "budget_exhausted"
      ],
      "report_schema": {
        "ref": {
          "name": "forge.report.implement",
          "version": 3
        }
      },
      "gates": [
        {
          "id": "first_done_checklist",
          "on_status": [
            "done"
          ],
          "config": {
            "reset_on_tools": [
              "Edit",
              "Write",
              "Bash"
            ]
          }
        },
        {
          "id": "report_crosscheck"
        }
      ],
      "spinoffs": {
        "max_per_run": 2,
        "max_depth": 0,
        "relations": [
          "blocks_this",
          "follows_this"
        ]
      }
    },
    "budgets": {
      "turns": {
        "$param": "turns"
      },
      "context_high_water_tokens": 160000,
      "wall_seconds": 5400,
      "tokens_by_tier": {
        "standard": 4000000,
        "strong": 0
      },
      "subagents_total": 12
    },
    "outputs": {
      "sinks": [
        {
          "id": "ticket_report",
          "kind": "comment",
          "when": {
            "terminal": [
              "complete"
            ]
          },
          "channel": {
            "type": "jira_comment",
            "target": {
              "$param": "issue_key"
            }
          },
          "render": {
            "template": "**Forge: {{status}}**\n\n{{summary}}\n\n{{#report.open_questions}}- {{.}}\n{{/report.open_questions}}",
            "attach": [
              "report_json",
              "evidence"
            ]
          },
          "idempotency_key": {
            "cel": "run.id + ':ticket_report'"
          }
        }
      ],
      "continuations": [
        {
          "id": "execute_approved",
          "on": {
            "terminal": "suspend",
            "answer": "approve"
          },
          "target": {
            "template": "self"
          },
          "params": {
            "issue_key": {
              "cel": "params.issue_key"
            },
            "repository": {
              "cel": "params.repository"
            },
            "base_branch": {
              "cel": "params.base_branch"
            },
            "target_branch": {
              "cel": "params.target_branch"
            },
            "write_scope": {
              "cel": "params.write_scope"
            }
          },
          "carry": [
            "approved_action",
            "resumed_answer"
          ],
          "gate": {
            "kind": "auto"
          }
        },
        {
          "id": "spinoff_blocking",
          "on": {
            "terminal": "complete",
            "status": [
              "blocked"
            ],
            "spinoff": "blocks_this"
          },
          "target": {
            "template": "self"
          },
          "params": {
            "issue_key": {
              "cel": "params.issue_key"
            },
            "repository": {
              "cel": "params.repository"
            },
            "base_branch": {
              "cel": "params.base_branch"
            },
            "target_branch": {
              "cel": "params.target_branch"
            },
            "write_scope": {
              "cel": "spinoff.paths"
            },
            "kinds": {
              "cel": "spinoff.kinds"
            }
          },
          "carry": [
            "prior_attempt"
          ],
          "gate": {
            "kind": "auto"
          },
          "via": "task"
        },
        {
          "id": "spinoff_following",
          "on": {
            "terminal": "complete",
            "spinoff": "follows_this"
          },
          "target": {
            "template": "self"
          },
          "params": {
            "issue_key": {
              "cel": "params.issue_key"
            },
            "repository": {
              "cel": "params.repository"
            },
            "base_branch": {
              "cel": "params.base_branch"
            },
            "target_branch": {
              "cel": "params.target_branch + '-follow-' + string(spinoff.index)"
            },
            "write_scope": {
              "cel": "spinoff.paths"
            }
          },
          "carry": [
            "prior_attempt"
          ],
          "gate": {
            "kind": "approval",
            "principal_set": [
              "issue_assignee",
              "issue_reporter"
            ],
            "channel": {
              "type": "jira_comment",
              "target": {
                "$param": "issue_key"
              }
            },
            "bind": "report_hash"
          },
          "via": "task"
        }
      ],
      "max_chain_depth": 3
    },
    "authority": {
      "run_as": [
        "user",
        "service"
      ],
      "service_principal": {
        "type": "service",
        "id": "forge-bot"
      },
      "delegation": {
        "max_ttl_days": 90,
        "scopes": [
          "jira:read",
          "jira:comment"
        ]
      }
    },
    "concurrency": {
      "key": {
        "cel": "params.repository + '#' + params.target_branch"
      },
      "policy": "queue",
      "handoff_occupies": true
    },
    "ledger": {
      "max_attempts": 2,
      "tasks_per_issue": 8
    }
  }
}

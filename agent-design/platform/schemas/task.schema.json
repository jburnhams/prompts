{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.example/schemas/task.schema.json",
  "title": "Task",
  "description": "A ledger task: an obligation that outlives any one run. orchestration.md \u00a72, restated against this platform's types: mode is replaced by a template, and scope.authority by principal plus delegation. Not model-facing.",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/Id"
    },
    "source": {
      "type": "string",
      "enum": [
        "trigger",
        "manual",
        "review_finding",
        "ci_failure",
        "spinoff",
        "continuation"
      ]
    },
    "template": {
      "$ref": "common.schema.json#/$defs/VersionedRef"
    },
    "params": {
      "type": "object",
      "description": "Frozen at filing. A later dispatch never re-resolves them."
    },
    "principal": {
      "$ref": "common.schema.json#/$defs/PrincipalRef"
    },
    "delegation_id": {
      "$ref": "common.schema.json#/$defs/Id"
    },
    "issue_key": {
      "type": [
        "string",
        "null"
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "filed",
        "ready",
        "running",
        "handoff",
        "parked",
        "blocked",
        "done",
        "abandoned"
      ]
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "urgent"
      ]
    },
    "depends_on": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/Id"
      }
    },
    "spun_off_from": {
      "$ref": "common.schema.json#/$defs/Id"
    },
    "spinoff_depth": {
      "type": "integer",
      "minimum": 0
    },
    "wake": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "gate",
            "pr",
            "build",
            "jira",
            "timer"
          ]
        },
        "predicate": {
          "$ref": "common.schema.json#/$defs/Expr"
        },
        "at": {
          "$ref": "common.schema.json#/$defs/Timestamp"
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "gate_id": {
      "$ref": "common.schema.json#/$defs/Id",
      "description": "filed tasks waiting on a follows_this approval."
    },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "run_id": {
            "$ref": "common.schema.json#/$defs/Id"
          },
          "started_at": {
            "$ref": "common.schema.json#/$defs/Timestamp"
          },
          "ended_at": {
            "$ref": "common.schema.json#/$defs/Timestamp"
          },
          "terminal": {
            "$ref": "common.schema.json#/$defs/Terminal"
          },
          "status": {
            "type": "string",
            "enum": [
              "done",
              "planned",
              "skipped",
              "failed",
              "blocked",
              "budget_exhausted",
              "lease_lost"
            ]
          },
          "summary": {
            "type": "string"
          }
        },
        "required": [
          "run_id",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "budget": {
      "type": "object",
      "properties": {
        "max_attempts": {
          "type": "integer",
          "minimum": 1
        },
        "attempts_used": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "max_attempts",
        "attempts_used"
      ],
      "additionalProperties": false
    },
    "abandon_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "supersedes": {
      "$ref": "common.schema.json#/$defs/Id"
    },
    "outcome": {
      "type": "object",
      "properties": {
        "target_branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "pull_request": {
          "type": [
            "string",
            "null"
          ]
        },
        "report": {
          "type": "object"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/Timestamp"
    },
    "updated_at": {
      "$ref": "common.schema.json#/$defs/Timestamp"
    },
    "concurrency_key": {
      "type": "string",
      "description": "The concurrency key value, e.g. owner/repo#branch. orchestration.md \u00a72 calls this field owner."
    }
  },
  "required": [
    "id",
    "source",
    "template",
    "params",
    "principal",
    "state",
    "attempts",
    "budget",
    "created_at"
  ],
  "additionalProperties": false
}

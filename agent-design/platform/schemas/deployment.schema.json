{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.example/schemas/deployment.schema.json",
  "title": "Deployment",
  "description": "Per-deployment facts no template may override: the tier map, provider capabilities, ceilings. See ../../platform.md §3e.",
  "type": "object",
  "properties": {
    "tiers": {
      "type": "object",
      "properties": {
        "economy": { "$ref": "#/$defs/TierBinding" },
        "standard": { "$ref": "#/$defs/TierBinding" },
        "strong": { "$ref": "#/$defs/TierBinding" }
      },
      "required": ["economy", "standard", "strong"],
      "additionalProperties": false
    },
    "providers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "api": { "type": "string", "enum": ["anthropic_messages", "bedrock_converse", "vertex", "openai_responses"] },
          "deferred_tools": { "type": "string", "enum": ["native", "client", "none"] },
          "cache_min_tokens": { "type": "integer", "minimum": 0 },
          "advisor": { "type": "boolean", "default": false }
        },
        "required": ["api", "deferred_tools"],
        "additionalProperties": false
      }
    },
    "max_tier": { "$ref": "common.schema.json#/$defs/Tier" },
    "defaults": {
      "type": "object",
      "properties": {
        "budgets": { "$ref": "run-spec.schema.json#/$defs/Budgets" },
        "checks": { "type": "array", "items": { "$ref": "tools.schema.json#/$defs/HarnessCheck" }, "description": "Added to every template's checks; a template cannot remove them." }
      },
      "additionalProperties": false
    }
  },
  "required": ["tiers", "providers", "max_tier"],
  "additionalProperties": false,
  "$defs": {
    "TierBinding": {
      "type": "object",
      "properties": {
        "provider": { "type": "string" },
        "model_id": { "type": "string" },
        "effort": { "$ref": "common.schema.json#/$defs/Effort" },
        "vision": { "type": "boolean" }
      },
      "required": ["provider", "model_id"],
      "additionalProperties": false
    }
  }
}

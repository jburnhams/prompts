{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keel.example/registry/report_schema/forge.finding/1",
  "title": "Review finding",
  "description": "From ../../formats.md §4. Raised by a reviewer with verdict null, then judged by the validator.",
  "type": "object",
  "properties": {
    "raised_by": {
      "enum": [
        "bugs_reviewer",
        "security_reviewer",
        "conventions_reviewer",
        "visual_reviewer",
        "single_stage"
      ],
      "description": "Which specialist raised it. ../../formats.md §4 calls this field role."
    },
    "id": {
      "type": "string"
    },
    "file": {
      "type": "string"
    },
    "line": {
      "type": "integer",
      "minimum": 1
    },
    "line_end": {
      "type": "integer",
      "minimum": 1
    },
    "severity": {
      "enum": [
        "blocking",
        "high",
        "medium",
        "low"
      ]
    },
    "class": {
      "enum": [
        "defect",
        "suggestion"
      ]
    },
    "summary": {
      "type": "string"
    },
    "rationale": {
      "type": "string"
    },
    "suggested_fix": {
      "type": [
        "string",
        "null"
      ]
    },
    "provenance": {
      "enum": [
        "introduced",
        "made_visible",
        "pre_existing"
      ],
      "description": "README decision 'Provenance claims in review findings'."
    },
    "verdict": {
      "enum": [
        "confirmed",
        "plausible",
        "refuted",
        null
      ]
    },
    "validator_note": {
      "type": [
        "string",
        "null"
      ]
    },
    "filtered_reason": {
      "type": "string",
      "description": "Only on entries in a review report's filtered list: why it was not posted."
    }
  },
  "required": [
    "raised_by",
    "file",
    "line",
    "severity",
    "class",
    "summary",
    "rationale",
    "verdict"
  ],
  "additionalProperties": false
}

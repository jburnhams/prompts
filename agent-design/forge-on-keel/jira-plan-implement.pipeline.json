{
  "name": "jira.plan-implement",
  "version": 1,
  "title": "Plan, then implement, a Jira ticket",
  "description": "Use case 2. A plan stage, a principal-approved handover of the plan to an implement stage, then the pipeline itself opens the PR from implement's checkout and keeps Jira up to date: In Review when the PR is open, Done when it merges.",
  "owner": {
    "type": "team",
    "id": "platform-agents"
  },
  "params": {
    "issue_key": {
      "type": "string",
      "trust": "config",
      "required": true,
      "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$"
    },
    "repository": {
      "type": "string",
      "trust": "config",
      "required": true,
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "target_branch": {
      "type": "string",
      "trust": "config",
      "required": true,
      "pattern": "^[A-Za-z0-9_./-]{1,200}$"
    }
  },
  "entry": "plan",
  "stages": {
    "plan": {
      "template": {
        "name": "forge.plan",
        "version": "pinned"
      },
      "params": {
        "issue_key": {
          "cel": "pipeline.params.issue_key"
        },
        "repository": {
          "cel": "pipeline.params.repository"
        },
        "target_branch": {
          "cel": "pipeline.params.target_branch"
        }
      },
      "retry": {
        "max_attempts": 2
      }
    },
    "implement": {
      "template": {
        "name": "forge.implement",
        "version": "pinned"
      },
      "params": {
        "issue_key": {
          "cel": "pipeline.params.issue_key"
        },
        "repository": {
          "cel": "pipeline.params.repository"
        },
        "target_branch": {
          "cel": "pipeline.params.target_branch"
        }
      },
      "retry": {
        "max_attempts": 2,
        "raise_budgets": {
          "turns": 1.5
        }
      },
      "settle": {
        "event": "pr",
        "ref": {
          "cel": "stage.links.pull_request"
        },
        "done_when": [
          "merged"
        ],
        "abandon_when": [
          "closed_unmerged"
        ],
        "link_within_s": 3600
      }
    }
  },
  "edges": [
    {
      "id": "plan_approved",
      "from": "plan",
      "on": {
        "terminal": "complete",
        "status": [
          "planned"
        ]
      },
      "to": "implement",
      "params": {
        "write_scope": {
          "cel": "result.report.write_scope"
        }
      },
      "carry": [
        "plan"
      ],
      "gate": {
        "kind": "approval",
        "principal_set": [
          "issue_assignee",
          "issue_reporter"
        ],
        "channel": {
          "type": "jira_comment",
          "target": {
            "origin": true
          }
        },
        "bind": "plan_hash",
        "expires_after_s": 1209600
      }
    }
  ],
  "sinks": [
    {
      "id": "open_pr",
      "kind": "tool",
      "at": {
        "stage": "implement",
        "event": "run_ended"
      },
      "when": {
        "terminal": [
          "complete"
        ],
        "status": [
          "done"
        ]
      },
      "tool": "mcp:scm/open_pull_request",
      "args": {
        "title": {
          "cel": "pipeline.params.issue_key + ': ' + result.report.suggested_commit_message.split('\\n')[0]"
        },
        "body": {
          "cel": "result.summary"
        }
      }
    },
    {
      "id": "jira_in_review",
      "kind": "tool",
      "at": {
        "stage": "implement",
        "event": "run_ended"
      },
      "when": {
        "terminal": [
          "complete"
        ],
        "status": [
          "done"
        ],
        "expr": {
          "cel": "has(stage.links.pull_request)"
        }
      },
      "tool": "mcp:jira/update_issue",
      "args": {
        "key": {
          "cel": "pipeline.params.issue_key"
        },
        "transition": "In Review"
      }
    },
    {
      "id": "jira_done",
      "kind": "tool",
      "at": {
        "stage": "implement",
        "event": "settled"
      },
      "tool": "mcp:jira/update_issue",
      "args": {
        "key": {
          "cel": "pipeline.params.issue_key"
        },
        "transition": "Done"
      }
    },
    {
      "id": "jira_summary",
      "kind": "comment",
      "channel": {
        "type": "jira_comment",
        "target": {
          "origin": true
        }
      },
      "render": {
        "template": "**Forge {{stage}}: {{result.status}}**\n\n{{result.summary}}"
      }
    }
  ],
  "max_hops": 1,
  "max_tier": "strong",
  "tools": {
    "servers": [
      {
        "id": "jira"
      },
      {
        "id": "scm"
      }
    ],
    "groups": [
      {
        "id": "jira.transition",
        "tools": [
          {
            "tool": "mcp:jira/update_issue",
            "annotations": {
              "idempotent": false,
              "retry": "never"
            }
          }
        ]
      },
      {
        "id": "pr",
        "tools": [
          {
            "tool": "mcp:scm/open_pull_request",
            "annotations": {
              "idempotent": false,
              "retry": "never"
            },
            "params": {
              "base": {
                "fixed": "main",
                "hidden": true
              },
              "draft": {
                "fixed": false,
                "hidden": true
              }
            },
            "links": {
              "pull_request": {
                "cel": "result.url"
              }
            }
          }
        ]
      }
    ]
  },
  "limits": {
    "spinoff_depth": 0,
    "runs_per_subject": 8
  }
}
